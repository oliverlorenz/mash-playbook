[Unit]
Description=uhabits-server ({{ uhabits_server_identifier }})
{% for service in uhabits_server_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in uhabits_server_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ uhabits_server_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ uhabits_server_identifier }} 2>/dev/null || true'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ uhabits_server_identifier }} \
      --log-driver=none \
      --user={{ uhabits_server_uid }}:{{ uhabits_server_gid }} \
      --cap-drop=ALL \
      --read-only \
      --tmpfs=/tmp:rw,noexec,nosuid,size=16m \
      --network={{ uhabits_server_container_network }} \
      {% if uhabits_server_container_http_host_bind_port %}
      -p {{ uhabits_server_container_http_host_bind_port }}:{{ uhabits_server_container_http_port }} \
      {% endif %}
      --env-file={{ uhabits_server_base_path }}/env \
      --label-file={{ uhabits_server_base_path }}/labels \
      --mount type=bind,src={{ uhabits_server_data_path }},dst=/data \
      {% for arg in uhabits_server_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ uhabits_server_container_image }}

{% for network in uhabits_server_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ uhabits_server_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ uhabits_server_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ uhabits_server_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ uhabits_server_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ uhabits_server_identifier }}

[Install]
WantedBy=multi-user.target
